<mujoco>
  <!-- A plain cylinder to grasp. Local frame: axis along z, so the default
       orientation stands it upright on the floor. Tall enough that all four
       fingers and the thumb can find it at once.

       No <compiler> or <option> here either: singletons that belong to the scene
       that includes this file. -->

  <worldbody>
    <body name="cylinder" pos="0 0 0.12">
      <freejoint name="cylinder_free"/>
      <geom name="cylinder_geom" type="cylinder" size="0.042 0.12"
            rgba="0.75 0.55 0.3 1" condim="3" friction="1.8 0.01 0.001"
            mass="0.30"/>
    </body>
  </worldbody>
</mujoco>
